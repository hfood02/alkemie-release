# ============================================================
# Alkemie Environment Template
# ============================================================
#
# This is the single maintained template for source checkouts and packaged
# releases. Copy it to .env beside this file and fill in real values:
#   cp .env.example .env
#
# .env contains runtime values such as API keys, database passwords, JWT secrets,
# TLS keys, model caches, and workspace data.
#
# To keep a host-specific file elsewhere, export ALKEMIE_ENV_FILE with its path
# before starting or deploying Alkemie. Existing backend/.env files are read only
# as a compatibility fallback and should not be used for new installations.

# Optional frontend build-time overrides. Vite embeds VITE_* values into the
# browser bundle, so never place secrets in them. Leave blank to use the current
# page origin and the development proxy.
VITE_SERVER_URL=
VITE_API_URL=

# Backend network.
# Direct mode:
#   ALKEMIE_USE_NGINX=false
#   The app listens on ALKEMIE_HOST:ALKEMIE_PORT.
#
# User-space nginx mode:
#   ALKEMIE_USE_NGINX=true
#   nginx listens on ALKEMIE_PORT, and the app listens only on
#   127.0.0.1:ALKEMIE_BACKEND_PORT. nginx config, pid, logs, and temp files stay
#   under this release directory and do not require sudo.
ALKEMIE_USE_NGINX=true
ALKEMIE_HOST=0.0.0.0
ALKEMIE_PORT=8443
ALKEMIE_BACKEND_PORT=8442
ALKEMIE_NGINX_DIR=./run/nginx
ALKEMIE_NO_SSL=false
# Optional override for the host printed by scripts/start.sh and used in generated
# self-signed certificates when nginx serves HTTPS. Leave blank to auto-detect;
# set it only if the detected service-node IP/DNS is wrong. Do not include scheme
# or port, for example alkemie.example.com.
ALKEMIE_PUBLIC_HOST=

# HTTPS for user-space nginx:
#   ALKEMIE_USE_NGINX=true
#   ALKEMIE_NO_SSL=false
# Leave these paths in the release directory to let scripts/start.sh generate a
# self-signed certificate, or point them at a site-provided certificate/key.
ALKEMIE_SSL_CERT=./certs/cert.pem
ALKEMIE_SSL_KEY=./certs/key.pem
ALKEMIE_SSL_DAYS=365

# Runtime workspace directories. Blank values use ~/alkemie-workspaces and its
# standard subdirectories in source deployments; packaged releases use their
# documented release-local defaults. Set absolute paths on HPC/shared filesystems.
# Keep persistent data outside the source checkout. Changing this root does not
# migrate existing databases or calculation archives; back up and migrate first.
ALKEMIE_WORKSPACES_ROOT=/data1/alkemie-share/workspaces
ALKEMIE_BASE_DIR=/data1/alkemie-share/workspaces/alkemie-projects
ALKEMIE_UPLOADS_DIR=/data1/alkemie-share/workspaces/alkemie-uploads
ALKEMIE_LOGS_DIR=/data1/alkemie-share/workspaces/alkemie-logs
ALKEMIE_POTCAR_DIR=/data1/alkemie-share/workspaces/potcar_library
# ABACUS installation settings are managed by the platform. Plane-wave
# calculations require a UPF library; LCAO also requires matching orbitals.
ABACUS_PP_PATH=/data1/alkemie-share/workspaces/abacus_pp_library/SG15_ONCV_v1.0_upf
ABACUS_ORBITAL_PATH=/data1/alkemie-share/workspaces/abacus_orbital_library
ABACUS_EXEC=abacus
ABACUS_ENV_SCRIPT=
LASP_POT_DIR=/data1/alkemie-share/workspaces/lasp_potential_library
LASP_EXEC=lasp
# Shared reads prefer the tenant library, then this administrator-managed
# public library. Uploads never overwrite the public library or another tenant.
HONPAS_PSEUDO_FOLDER=/data1/alkemie-share/workspaces/honpas_pseudo_library

# Safe single-user defaults. Trusted shared HPC directories may require 0000
# and 0777, but prefer group ACLs and the narrowest permissions that work.
ALKEMIE_FILE_UMASK=0022
ALKEMIE_GENERATED_SCRIPT_MODE=0755

# One process-wide profile selects identity and execution behavior:
#   local   - single user, direct execution as the current Unix user
#   shared  - platform users share the backend Unix service account
#   cluster - platform users map 1:1 to Unix identities through one Gateway
ALKEMIE_DEPLOYMENT_PROFILE=local

# Single-process ASGI runtime. Flask REST requests use the bounded WSGI worker
# pool; Socket.IO emit/room operations use the ordered dispatcher queue.
ALKEMIE_ASGI_WSGI_WORKERS=10
ALKEMIE_REALTIME_QUEUE_CAPACITY=4096
ALKEMIE_REALTIME_DISPATCH_TIMEOUT_SECONDS=5
ALKEMIE_REALTIME_DRAIN_TIMEOUT_SECONDS=15
# Maximum time allowed to finish sending one HTTP request header block. This
# protects the direct ASGI listener as well as deployments behind nginx.
ALKEMIE_HTTP_HEADER_TIMEOUT_SECONDS=15
# Source deployment readiness budget after the Python process has started.
# Historical project reconciliation and RAG prewarming run asynchronously.
ALKEMIE_DEPLOY_WEB_HEALTH_TIMEOUT_SECONDS=60
# Graceful-stop budget covering Uvicorn connection draining followed by the
# bounded monitor, dispatcher, Socket.IO, and RAG prewarm shutdown stages.
ALKEMIE_DEPLOY_WEB_STOP_TIMEOUT_SECONDS=65

# shared and cluster require PostgreSQL and a strong JWT secret. The supported
# browser deployment is same-origin, so changing the public host or port needs no
# origin setting.
DATABASE_URL=postgresql://username:password@db-host:5432/alkemie
JWT_SECRET_KEY=replace-with-a-unique-32-plus-character-secret
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=14
# Set true when the browser reaches Alkemie exclusively over HTTPS.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Optional OIDC; issuer subjects must be explicitly bound to existing user UUIDs.
ALKEMIE_PUBLIC_URL=
ALKEMIE_OIDC_ISSUER=
ALKEMIE_OIDC_CLIENT_ID=
ALKEMIE_OIDC_CLIENT_SECRET=
ALKEMIE_OIDC_AUDIENCE=alkemie
ALKEMIE_OIDC_USERS={}
# Optional MongoDB URI for structure database features. Leave blank to disable.
# ALKEMIE_MONGO_URI is the fallback for the built-in structure database.
ALKEMIE_MONGO_URI=

# Optional per-database MongoDB settings. Leave URI blank to fall back to ALKEMIE_MONGO_URI.
ALKEMIE_MASTER_MONGO_URI=
ALKEMIE_MASTER_MONGO_DATABASE=alkemiems_db
ALKEMIE_MASTER_STRUCTURE_COLLECTION=MasterStructure
# Optional local built-in snapshot; uses the existing SQLite catalog index instead of MongoDB.
ALKEMIE_MASTER_STRUCTURES_JSON=

# Optional JSON path for the MP online database. Leave blank to use
# public/mp_all_structures.json relative to the application directory.
ALKEMIE_MP_STRUCTURES_JSON=
# Optional JARVIS snapshot path; defaults to public/jdft_3d-9-24-2025.json.
ALKEMIE_JARVIS_STRUCTURES_JSON=
ALKEMIE_CALISOL_JSON=
ALKEMIE_CATALOG_INDEX_ROOT=

# Codex App Server model provider. Keep the key in this environment file.
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional backup provider. Retried only before a turn emits output or runs a tool.
LLM_BACKUP_PROVIDER=deepseek
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=https://api.deepseek.com
LLM_BACKUP_MODEL=deepseek-flash
# Fallback for automatic analysis when a legacy project has no saved language.
# Bounded platform-wide analysis pool (1-16); queued nodes retain project isolation.
ALKEMIE_ANALYSIS_WORKERS=4
# Admission limits for pending analyses (running tasks are excluded).
ALKEMIE_ANALYSIS_PENDING_LIMIT=1000
ALKEMIE_ANALYSIS_USER_PENDING_LIMIT=100
ANALYSIS_DEFAULT_LOCALE=zh

# Embedding settings.
# local uses SentenceTransformer(EMBEDDING_MODEL) and reads HuggingFace cache
# from HF_HOME/HF_HUB_CACHE. Keep offline flags enabled for closed networks.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG indexes are versioned and persisted below ALKEMIE_WORKSPACES_ROOT by
# default. Override the directory only when indexes belong on another volume.
ALKEMIE_RAG_CACHE_DIR=
# Comma-separated software integrations to prewarm after server startup.
ALKEMIE_RAG_PREWARM_SOFTWARES=vasp,gnep,lammps,honpas,gpumd
# auto prefers FAISS and falls back to NumPy when the native ABI is unavailable.
ALKEMIE_RAG_VECTOR_BACKEND=auto
OPENAI_API_KEY=
HF_HOME=./model-cache
HF_HUB_CACHE=./model-cache/hub
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Cluster Gateway control-plane settings. Required only for the cluster profile.
ALKEMIE_GATEWAY_SIGNING_KEY_FILE=./secrets/gateway-signing-key.pem
ALKEMIE_GATEWAY_ENROLLMENT_TTL_MINUTES=15
ALKEMIE_GATEWAY_TASK_LEASE_SECONDS=120
ALKEMIE_GATEWAY_OFFLINE_SECONDS=60
ALKEMIE_PRIVILEGED_REQUEST_TTL_SECONDS=120
ALKEMIE_GATEWAY_FILE_OPERATION_TIMEOUT_SECONDS=15
ALKEMIE_GATEWAY_COMMAND_SESSION_TIMEOUT_SECONDS=45
ALKEMIE_GATEWAY_FILE_DOWNLOAD_MAX_BYTES=26214400
ALKEMIE_GATEWAY_ARTIFACT_MAX_FILE_BYTES=26214400
ALKEMIE_GATEWAY_ARTIFACT_MAX_TOTAL_BYTES=262144000
ALKEMIE_GATEWAY_ARTIFACT_MAX_FILES=2000
ALKEMIE_GATEWAY_ARTIFACT_EXCLUDE_PATTERNS=.git,.svn,.hg,__pycache__,.pytest_cache,.mypy_cache,.DS_Store
ALKEMIE_QUEUE_JOB_DISPLAY_LIMIT=200
ALKEMIE_SCHEDULER_COMMAND_TIMEOUT_SECONDS=30
# Batch script policy. local/shared may use auto detection; cluster must select
# pbs or slurm and an explicit launcher (mpirun, mpiexec, or srun).
ALKEMIE_SCHEDULER_TYPE=auto
ALKEMIE_MPI_LAUNCHER=auto
# RG2 executables. The converter is bundled only in Linux x86_64 releases;
# other platforms must provide an executable path explicitly.
ALKEMIE_RG2_EXECUTABLE=rg2
ALKEMIE_RG2_RES2VASP_EXECUTABLE=
ALKEMIE_JOB_DEFAULT_NODES=1
ALKEMIE_JOB_DEFAULT_PPN=32
ALKEMIE_JOB_DEFAULT_WALLTIME=24:00:00
ALKEMIE_JOB_DEFAULT_QUEUE=batch
ALKEMIE_JOB_MAX_NODES=1000
ALKEMIE_JOB_MAX_PPN=256
ALKEMIE_JOB_MAX_WALLTIME=999:59:59
# Optional comma-separated allowlist. Empty accepts any syntactically valid queue.
ALKEMIE_SCHEDULER_ALLOWED_QUEUES=
# Server-owned active-learning execution scope. Requests and saved plans cannot
# override it. Use a stable distinct value if deployments share a control DB.
ALKEMIE_ACTIVE_LEARNING_CLUSTER_ID=configured-cluster
# Scheduler evidence older than this is rejected before active-learning submission.
ALKEMIE_ACTIVE_LEARNING_RESOURCE_SNAPSHOT_TTL_SECONDS=30

# Agent command-session limits. exec/wait values only bound one blocking tool
# call; the underlying command keeps running until it exits or is killed.
ALKEMIE_COMMAND_EXEC_WAIT_SECONDS=10
ALKEMIE_COMMAND_WAIT_SECONDS=30
ALKEMIE_COMMAND_MAX_SESSIONS=8
ALKEMIE_COMMAND_SESSION_IDLE_SECONDS=1800

# Inline conversation previews only. Exact tool arguments/results are stored
# separately as gzip artifacts under each project's .alkemie directory.
ALKEMIE_CONVERSATION_TOOL_ARGUMENT_PREVIEW_CHARS=2000
ALKEMIE_CONVERSATION_TOOL_RESULT_PREVIEW_CHARS=32000
# Set to 0 to omit persisted reasoning previews entirely.
ALKEMIE_CONVERSATION_REASONING_PREVIEW_CHARS=20000

# Process-local recovery for browser refreshes, route changes, and transient
# WebSocket reconnects. Active streams are never evicted by the terminal cap.
ALKEMIE_AGENT_STREAM_RECOVERY_TTL_SECONDS=120
ALKEMIE_AGENT_STREAM_RECOVERY_MAX_TERMINAL_SESSIONS=256
ALKEMIE_AGENT_STREAM_RECOVERY_MAX_EVENTS=512
ALKEMIE_DRAFT_RETENTION_DAYS=7

# Standalone auto-correction worker. Scientific/resource patches remain capped
# by schema and scheduler policy; these values only tighten the fixed limits.
ALKEMIE_AUTOCORRECTION_AUDIT_RETENTION_DAYS=365
ALKEMIE_AUTOCORRECTION_MAX_ATTEMPTS=3
ALKEMIE_AUTOCORRECTION_WORKER_POLL_SECONDS=2
ALKEMIE_AUTOCORRECTION_WORKER_LEASE_SECONDS=120
ALKEMIE_AUTOCORRECTION_WORKER_HEARTBEAT_SECONDS=10
ALKEMIE_AUTOCORRECTION_EVIDENCE_MAX_BYTES=65536
ALKEMIE_AUTOCORRECTION_RESOURCE_GROWTH_FACTOR=2
ALKEMIE_AUTOCORRECTION_RAG_RETRY_SECONDS=300
ALKEMIE_AUTOCORRECTION_RAG_SEMANTIC_CANDIDATES=8
ALKEMIE_AUTOCORRECTION_RAG_MAX_CHUNKS=24

# Optional Python executable for Agent commands and large-file reads.
ALKEMIE_PROJECT_PYTHON=

# Structured CSV/Excel/Word preview byte budget (64 MiB default); downloads are unaffected.
ALKEMIE_DOCUMENT_PREVIEW_MAX_BYTES=67108864
# Optional path to the official LIBE JSON; defaults to public/libe.json.
ALKEMIE_LIBE_STRUCTURES_JSON=
ALKEMIE_COMBAT_STRUCTURES_JSON=
# Optional OBELiX snapshot path; defaults to public/obelix.json.
ALKEMIE_OBELIX_JSON=

# Exact allowed parent origins for embedded workbenches; empty forbids embedding.
# Prefer same-site HTTPS subdomains to preserve browser session cookies.
ALKEMIE_EMBED_ORIGINS=

# Optional trusted-platform automatic member binding; no effect when unset.
# JSON maps stable issuer IDs to public_key_file and the platform's fixed login_url.
# Private signing keys belong only on the issuing platform, never on Alkemie.
ALKEMIE_FEDERATION_TRUST=

# Optional local Archeos public client: existing-user consent with PKCE, no instance keys.
# Requires shared/cluster mode and ALKEMIE_PUBLIC_URL with valid HTTPS.
ALKEMIE_USER_AUTHORIZATION_ENABLED=false
