# ============================================================
# Alkemie Environment Template
# ============================================================
#
# Copy this file to .env in the release directory and fill in real values:
#   cp .env.example .env
#
# .env contains runtime values such as API keys, database passwords, JWT secrets,
# TLS keys, model caches, and workspace data.

# Backend network.
ALKEMIE_HOST=0.0.0.0
ALKEMIE_PORT=8443
ALKEMIE_NO_SSL=true

# Runtime workspace directories.
# Use absolute paths on HPC/shared filesystems. These directories hold user
# projects, uploads, logs, runner artifacts, and optional POTCAR files.
ALKEMIE_WORKSPACES_ROOT=/data1/alkemie-share/workspaces
ALKEMIE_BASE_DIR=/data1/alkemie-share/workspaces/alkemie-projects
ALKEMIE_UPLOADS_DIR=/data1/alkemie-share/workspaces/alkemie-uploads
ALKEMIE_LOGS_DIR=/data1/alkemie-share/workspaces/alkemie-logs
ALKEMIE_SERVER_DIR=/data1/alkemie-share/workspaces/alkemie-server
ALKEMIE_POTCAR_DIR=/data1/alkemie-share/workspaces/potcar_library

# Public shared HPC directories may need permissive modes so runner accounts can
# write submit scripts and results. Use tighter group ACLs when available.
ALKEMIE_FILE_UMASK=0000
ALKEMIE_GENERATED_SCRIPT_MODE=0777

# Deployment mode is chosen by editing this .env at runtime. The same Nuitka
# release package supports both single-user and multi-user mode.
#
# Single-user mode is simplest for one service account. The backend process
# submits jobs directly when ALKEMIE_EXECUTION_BACKEND=standalone.
MULTI_USER_MODE=False
ALKEMIE_EXECUTION_BACKEND=standalone

# Multi-user mode requires PostgreSQL, a strong JWT secret, and explicit allowed
# origins. To let each user submit jobs with their own HPC account, also set:
#   ALKEMIE_EXECUTION_BACKEND=cluster_runner
DATABASE_URL=postgresql://username:password@db-host:5432/alkemie
JWT_SECRET_KEY=replace-with-a-unique-32-plus-character-secret
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=14
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=Lax
ALKEMIE_ALLOWED_ORIGINS=https://your-ui.example.com,http://localhost:8443,http://localhost:3000

# Optional MongoDB URI for structure database features. Leave blank to disable.
ALKEMIE_MONGO_URI=

# AI Agent LLM settings. Providers are OpenAI-compatible: deepseek | openai | local.
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=60

# Optional per-agent overrides:
# LLM_MODEL_DESIGN_DECISION=deepseek-v4-pro
# LLM_MODEL_PARAMETER_OPTIMIZER=deepseek-v4-pro
# LLM_MODEL_SCIENTIFIC_INTERPRETER=deepseek-v4-pro
# LLM_MODEL_WORKFLOW_ARCHITECT=deepseek-v4-flash
# LLM_MODEL_MODELING=deepseek-v4-flash
# LLM_MODEL_COMPONENT_ANALYZER=deepseek-v4-flash
# LLM_THINKING_WORKFLOW_ARCHITECT=enabled
# LLM_REASONING_EFFORT_WORKFLOW_ARCHITECT=high

# Embedding settings.
# local uses SentenceTransformer(EMBEDDING_MODEL) and reads HuggingFace cache
# from HF_HOME/HF_HUB_CACHE. Keep offline flags enabled for closed networks.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
HF_HOME=./model-cache
HF_HUB_CACHE=./model-cache/hub
HUGGINGFACE_HUB_CACHE=./model-cache/hub
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# Runner and artifact limits.
ALKEMIE_RUNNER_FILE_OPERATION_TIMEOUT_SECONDS=15
ALKEMIE_RUNNER_FILE_DOWNLOAD_MAX_BYTES=26214400
ALKEMIE_RUNNER_ARTIFACT_MAX_FILE_BYTES=26214400
ALKEMIE_RUNNER_ARTIFACT_MAX_TOTAL_BYTES=262144000
ALKEMIE_RUNNER_ARTIFACT_MAX_FILES=2000
ALKEMIE_RUNNER_ARTIFACT_EXCLUDE_PATTERNS=.git,.svn,.hg,__pycache__,.pytest_cache,.mypy_cache,.DS_Store

# Project Python execution limits.
ALKEMIE_PROJECT_PYTHON_TIMEOUT_SECONDS=30
ALKEMIE_PROJECT_PYTHON_OUTPUT_MAX_BYTES=262144
ALKEMIE_PROJECT_PYTHON_ALLOWED_DIRS=scripts
